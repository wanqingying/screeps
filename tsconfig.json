{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["es2019"],
    "target": "es2019",
    "moduleResolution": "Node",
    "outDir": "dist",
    "baseUrl": "src/",
    "sourceMap": true,
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "paths": {
      "src/*": ["*"]
    }
  },
  "exclude": ["node_modules"]
}
